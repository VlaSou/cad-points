{
  "name": "@vlasou/cad-points",
  "version": "0.6.0",
  "description": "CadPoints AutoCAD LT bundle for exporting and annotating coordinate points.",
  "license": "UNLICENSED",
  "private": false,
  "type": "commonjs",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "check": "py -3 tests/run_static_tests.py",
    "test": "pnpm check",
    "build:zip": "py -3 scripts/build_release.py",
    "build": "pnpm build:zip",
    "release:check": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "files": [
    "dist/CadPoints.bundle",
    "scripts/install_windows.bat",
    "README.md",
    "README.cs-CZ.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/VlaSou/cad-points.git"
  },
  "bugs": {
    "url": "https://github.com/VlaSou/cad-points/issues"
  },
  "homepage": "https://github.com/VlaSou/cad-points#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  }
}
